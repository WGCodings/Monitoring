# Copy to .env on the Pi (never commit .env)

# Beszel: the public key from the hub's "Add system" dialog (see README).
# Leave the placeholder for the very first start, then fill it in.
BESZEL_AGENT_KEY=ssh-ed25519 replace-me

# Login for monitor.wgcodings.com/traffic (GoAccess report).
# Create the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ characters.
TRAFFIC_USER=admin
TRAFFIC_PASS_HASH='$2a$14$replace-with-the-hash'
