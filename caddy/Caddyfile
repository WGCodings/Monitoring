# The one reverse proxy for everything on pi-alpha. It owns ports 80/443
# and gets Let's Encrypt certificates automatically for every site below,
# as long as the site's DNS record points at the Pi.
#
# One file per site in sites/. To add a new app:
#   1. put its containers on the shared `edge` network,
#   2. add sites/<app>.caddy (with `import access_log` to count its visits),
#   3. add the DNS record at Combell,
#   4. `docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile`

{
	# Optional: e-mail for Let's Encrypt expiry notices
	# email you@example.com
}

# Access log shared by all sites (JSON), read by GoAccess for the traffic
# report. Rotated at 50 MB, 5 old files kept.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

import sites/*.caddy
